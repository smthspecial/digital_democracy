# Copy to .env; replace every blank with an independently generated random secret.
# Hex passwords avoid URL escaping. Example generator: openssl rand -hex 32
POSTGRES_PASSWORD=
API_GO_PASSWORD=
API_TS_APP_PASSWORD=
API_TS_WORKER_PASSWORD=
NATS_API_GO_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
INTERNAL_SERVICE_SHARED_SECRET=
IDENTITY_VERIFIER_SHARED_SECRET=
IDENTITY_HASH_SECRET=
AUDIT_SIGNING_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3001
# Casting rejects requests until a real cryptographic proof service is configured.
BALLOT_VERIFIER_URL=
