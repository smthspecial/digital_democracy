PORT=4004

# Optional: real cross-service wiring for AuditEmitter/ConstitutionalReviewer.
# Unset -> both fall back to no-op defaults so the service still runs standalone.
AUDIT_SERVICE_URL=http://localhost:5003

# Optional: real cross-service wiring for JurisdictionClient.
# Unset -> falls back to the permissive default so the service still runs standalone.
JURISDICTION_SERVICE_URL=http://localhost:4002

# Optional: real cross-service wiring for ProblemStatusNotifier.
# Unset -> falls back to the no-op default so the service still runs standalone.
PROBLEM_SERVICE_URL=http://localhost:4003

# Optional: real queue wiring for AuditEmitter via the audit.append queue (ADR-023).
# Takes priority over AUDIT_SERVICE_URL's HTTP AuditEmitter when both are set.
# Unset -> falls back to AUDIT_SERVICE_URL's HTTP AuditEmitter, or the no-op default.
NATS_URL=nats://localhost:4222
