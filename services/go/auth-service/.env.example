PORT=5004

# Optional: real cross-service wiring for IdentityChecker.
# Unset -> login fails closed (no citizen is ever treated as active) rather
# than trusting a caller-supplied status.
IDENTITY_SERVICE_URL=http://localhost:4001

# Optional: real queue wiring for AuditEmitter via the audit.append queue
# (ADR-023). This is the only AuditEmitter wiring this service has (no HTTP
# fallback). Unset -> falls back to the no-op default.
NATS_URL=nats://localhost:4222
