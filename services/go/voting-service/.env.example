PORT=5001

# Optional: real cross-service wiring for DelegationResolver/AuditEmitter.
# Unset -> both fall back to no-op defaults so the service still runs standalone.
DELEGATION_SERVICE_URL=http://localhost:5002
AUDIT_SERVICE_URL=http://localhost:5003

# Optional: real queue wiring for AuditEmitter via the audit.append queue
# (ADR-023). Takes priority over AUDIT_SERVICE_URL when both are set.
# Unset -> falls back to AUDIT_SERVICE_URL's HTTP AuditEmitter, or the no-op default.
NATS_URL=nats://localhost:4222
