PORT=4000

# Persistence (ADR-028/ADR-030): both required. api-ts does NOT migrate
# itself at boot (unlike apps/api-go) -- run
#   pnpm --filter @dd/api-ts exec prisma migrate deploy
# against DATABASE_URL (or a superuser URL) before starting the app.
# `app` authenticates as the RLS-scoped `api_app` role; `worker` as the
# broader-access `api_worker` role (ARCH-023 §4.3).
DATABASE_URL=postgres://api_app:api_app_dev@localhost:55433/api_ts
WORKER_DATABASE_URL=postgres://api_worker:api_worker_dev@localhost:55433/api_ts

# Identity (FR-001/FR-002): HMAC key for hashing legal identifiers before
# they're ever persisted (see identity/legal-identity-hash.ts). Every spec
# defaults this to "test-secret" when unset -- set a real secret outside
# local dev.
IDENTITY_HASH_SECRET=test-secret

# Cross-runtime HTTP seams (apps/api-go). AUTH_SERVICE_URL validates bearer
# sessions for every authenticated api-ts request; public reads still work
# without it, but protected routes return authentication_unavailable until it
# is configured. The other URLs remain optional best-effort seams.
AUDIT_SERVICE_URL=http://localhost:5000
AUTH_SERVICE_URL=http://localhost:5000
# Authenticated api-ts -> api-go internal calls. Must match api-go.
INTERNAL_SERVICE_SHARED_SECRET=
# Separate trusted government/assisted identity verifier callback key.
IDENTITY_VERIFIER_SHARED_SECRET=
NOTIFICATION_SERVICE_URL=

# Postgres-backed integration test tier (*.service.spec.ts,
# *.controller.e2e.spec.ts -- see src/test-support/postgres.ts). All three
# required together or the tier skips (set REQUIRE_DB_TESTS=1 to make a
# missing/incomplete trio a hard error instead of a silent skip). Deliberately
# TEST_TS_*, not TEST_* -- apps/api-go's own Postgres-backed tests read the
# unprefixed TEST_DATABASE_URL for the *api_go* database; sharing the name
# across runtimes points one suite at the other's schema.
TEST_TS_DATABASE_URL=postgres://api_app:api_app_dev@localhost:55433/api_ts
TEST_TS_WORKER_DATABASE_URL=postgres://api_worker:api_worker_dev@localhost:55433/api_ts
TEST_TS_ADMIN_DATABASE_URL=postgres://dd:dd@localhost:55433/api_ts
REQUIRE_DB_TESTS=
