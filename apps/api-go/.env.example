PORT=5000
# Persistence (ADR-029): unset = in-memory stores. Set to use Postgres
# (migrations in db/migrations run automatically at boot).
DATABASE_URL=postgres://dd:dd@localhost:5432/api_go?sslmode=disable
# Event backbone (ADR-023): unset = HTTP/no-op seams. Shared by all emitters
# plus the audit.append durable consumer.
NATS_URL=nats://localhost:4222
# HTTP integration seams (used when NATS is unset, or the specific peer):
AUDIT_SERVICE_URL=
DELEGATION_SERVICE_URL=
COMPETENCY_SERVICE_URL=http://localhost:4000
IDENTITY_SERVICE_URL=http://localhost:4000
# Authenticated api-ts -> api-go internal calls. Use a high-entropy secret,
# identical in both runtimes. api-go fails closed when this is unset.
INTERNAL_SERVICE_SHARED_SECRET=
# Explicit RP configuration: no automatic localhost fallback in production.
# For a local browser on localhost:3000, set these two values explicitly.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGIN=
# Scheduler (in-process, ADR-027 -- no separate scheduler container). Go
# duration syntax; unset = 24h (DP-045's "cron, daily").
DELEGATION_EXPIRY_INTERVAL=
# DP-067 session cleanup. Go duration syntax; unset = 24h.
AUTH_PURGE_INTERVAL=
# Left unset on purpose (BUG-003): notification-service (SRV-015) has no
# module, no schema and no routes in either runtime (ADR-031, ARCH-023 §1
# carve-out) -- there is nowhere for a dispatch POST to land yet. Setting
# this to a URL that resolves to something-that-isn't-notification-service
# reproduces the exact silent-404 failure BUG-001 was. main.go logs a
# warning at startup if this is set anyway.
NOTIFICATION_SERVICE_URL=
