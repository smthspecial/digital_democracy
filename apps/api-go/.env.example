PORT=5000
# Persistence (ADR-029): unset = in-memory stores. Set to use Postgres
# (migrations in db/migrations run automatically at boot).
DATABASE_URL=postgres://dd:dd@localhost:5432/api_go?sslmode=disable
# Event backbone (ADR-023): unset = HTTP/no-op seams. Shared by all emitters
# plus the audit.append durable consumer.
NATS_URL=nats://localhost:4222
# HTTP integration seams (used when NATS is unset, or the specific peer):
AUDIT_SERVICE_URL=
DELEGATION_SERVICE_URL=
COMPETENCY_SERVICE_URL=http://localhost:4000
IDENTITY_SERVICE_URL=http://localhost:4000
NOTIFICATION_SERVICE_URL=http://localhost:4000
