{
  "name": "digital-democracy",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:passkeys": "cd apps/api-go && REQUIRE_BROWSER_TESTS=1 go test ./internal/auth -run TestBrowserPasskey -count=1 -v",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "test:security-dependencies": "node testing/security/dependency-audit.mjs"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "playwright": "1.64.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "esbuild"
    ],
    "overrides": {
      "lodash": "^4.18.0",
      "fast-xml-parser": "^5.7.0",
      "uuid": "^11.1.1",
      "deepmerge-ts": "^8.0.0",
      "mysql2": "^3.23.1"
    },
    "patchedDependencies": {
      "node-forge@1.4.0": "patches/node-forge@1.4.0.patch",
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "sprintf-js@1.0.3": "patches/sprintf-js@1.0.3.patch"
    }
  }
}
